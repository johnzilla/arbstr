# Environment variables arbstr core reads. Core does not load this file itself:
# export them in your shell (set -a; source .env; set +a) or pass it to Docker
# (docker run --env-file .env ...). For the full stack, use arbstr-node's .env.example.
# Values are referenced from config.toml with ${VAR}.

# Shared secret for vault's internal API (config.toml: [vault] internal_token)
# VAULT_INTERNAL_TOKEN=

# Bearer token for /v1/stats and /v1/requests (config.toml: [server] operator_token)
# ARBSTR_OPERATOR_TOKEN=

# Provider keys: either referenced as ${VAR} from [[providers]] api_key, or found
# by convention as ARBSTR_<PROVIDER_NAME>_API_KEY when api_key is omitted
# ARBSTR_ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# Log level
RUST_LOG=arbstr=info
